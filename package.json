{
    "name": "denev cli website",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "min/index.html",
    "scripts": {
        "build": "node scripts/build-docs.js && node scripts/build-cookbook.js && rollup -c",
        "dev": "node scripts/build-docs.js && node scripts/build-cookbook.js && rollup -c -w",
        "preview": "pnpm build && (pkill -9 workerd || true) && wrangler pages dev min --ip 127.0.0.1 --compatibility-date 2026-07-21"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "posthog-js": "^1.441.2",
        "typewriter-effect": "^2.22.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.2",
        "cssnano": "^9.9.0",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "markdown-it": "^15.0.3",
        "markdown-it-attrs": "^5.0.1",
        "postcss": "^8.5.32",
        "rollup": "^4.66.0",
        "rollup-plugin-copy": "^3.5.0",
        "wrangler": "^4.155.0"
    }
